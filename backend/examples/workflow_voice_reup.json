{
    "name": "Auto Voice Reup",
    "description": "Generate voiceover and reup video",
    "nodes": [
        {
            "id": "tts_node",
            "type": "TTSGeneration",
            "inputs": {
                "text": "This is a sample narration generated by AI. It replaces the original audio.",
                "voice": "alloy",
                "provider": "auto"
            },
            "outputs": {
                "audio_path": "data/temp/narration.mp3"
            },
            "position": {
                "x": 100,
                "y": 100
            }
        },
        {
            "id": "reup_node",
            "type": "VideoReup",
            "inputs": {
                "video_path": "data/downloads/test_video.mp4",
                "platform": "tiktok",
                "add_captions": true
            },
            "outputs": {
                "output_path": "data/processed/reup_video.mp4",
                "thumbnail_path": ""
            },
            "position": {
                "x": 400,
                "y": 100
            }
        }
    ],
    "connections": [
        {
            "source_node": "tts_node",
            "source_output": "audio_path",
            "target_node": "reup_node",
            "target_input": "audio_path"
        }
    ],
    "metadata": {
        "category": "reup",
        "tags": [
            "tts",
            "reup",
            "voiceover"
        ]
    }
}