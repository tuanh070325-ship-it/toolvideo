# Backend Configuration
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=sqlite:///./video_reup.db

# API Keys - LLM Services
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GROQ_API_KEY=your_groq_key_here

# LTX-Video Configuration
LTX_MODEL_PATH=models/ltx-video/ltxv-13b-0.9.8-distilled.safetensors
LTX_TEXT_ENCODER_PATH=google/t5-v1_1-xxl
LTX_DEVICE=cuda
LTX_PRECISION=bfloat16
LTX_HEIGHT=704
LTX_WIDTH=1216
LTX_NUM_FRAMES=121
LTX_FRAME_RATE=30
LTX_INFERENCE_STEPS=50
LTX_GUIDANCE_SCALE=3.0
LTX_OFFLOAD_CPU=false
LTX_ENHANCE_PROMPT=false

# Opik Monitoring
OPIK_API_KEY=your_opik_key_here
OPIK_WORKSPACE=video-tool
OPIK_PROJECT=production

# Rememberall Memory
REMEMBERALL_STORAGE_PATH=data/memory
REMEMBERALL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ComfyUI Configuration
COMFYUI_PORT=8188
COMFYUI_MODELS_PATH=models
COMFYUI_OUTPUT_PATH=backend/data/outputs/comfyui

# FFmpeg Paths
FFMPEG_PATH=backend/ffmpeg.exe
FFPROBE_PATH=backend/ffprobe.exe

# Storage Paths
UPLOAD_DIR=backend/uploads
OUTPUT_DIR=backend/data/outputs
TEMP_DIR=backend/temp
MODELS_DIR=models

# Video Processing Settings
MAX_VIDEO_SIZE_MB=500
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv,webm
DEFAULT_VIDEO_QUALITY=high

# AI Settings
DEFAULT_AI_MODEL=gpt-4
MAX_TOKENS=4000
TEMPERATURE=0.7

# Security
SECRET_KEY=your-secret-key-change-this-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=backend/logs/app.log

# Performance
MAX_WORKERS=4
ENABLE_CACHING=true
CACHE_TTL=3600

# Feature Flags
ENABLE_LTX_VIDEO=true
ENABLE_OPIK_MONITORING=true
ENABLE_REMEMBERALL_MEMORY=true
ENABLE_COMFYUI=true
ENABLE_GENESIS=false
